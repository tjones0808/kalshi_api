PORT=3000
API_KEYS=replace-me-with-a-long-random-key-32
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_TIMEOUT_MS=8000
KALSHI_DEADLINE_MS=20000
CACHE_MAX_ENTRIES=5000
CACHE_TTL_SERIES_MS=3600000
CACHE_TTL_MARKETS_MS=15000
CACHE_TTL_ORDERBOOK_MS=5000
CACHE_TTL_LIVE_MS=5000
CACHE_TTL_TRADES_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_ANON_MAX=30

# Optional Kalshi credentials. Set the key id and ONE private key
# source, or leave all of them unset for public data only. With them
# set, every Kalshi request is signed and /v1/portfolio/* plus the
# MCP portfolio tools turn on (read-only).
# KALSHI_API_KEY_ID=your-kalshi-key-id
# Private key: a PEM file path...
# KALSHI_PRIVATE_KEY_PATH=./kalshi.pem
# ...or the key itself: a multiline PEM, a PEM on one line with
# literal \n escapes, or base64 of the PEM (base64 -w0 kalshi.pem).
# KALSHI_PRIVATE_KEY=paste-private-key-here

# Optional: limit portfolio access to some API_KEYS (comma-separated,
# each also listed in API_KEYS). Unset means every API key may read it.
# PORTFOLIO_API_KEYS=one-of-the-api-keys-above
